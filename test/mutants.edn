;; The mutation table. One entry per guard that must not silently stop
;; guarding, each recording the exact code that carries it and the test that
;; noticed when it was taken away.
;;
;; Every entry here was RUN as a mutant during the change that introduced it,
;; and :killed-by is the test that actually failed — not a guess. That field is
;; the point of the table: "3/3 killed" hides the mutant nobody wrote, and a
;; mutant killed by no named test is a hole rather than a score.
;;
;;   :file       the script the guard lives in
;;   :ns         the test namespace substring to run — `bb test <ns>`
;;   :old        the exact current text. MUST match once; a table entry whose
;;               anchor is gone is a signal that the guard moved, and the
;;               runner fails on it rather than skipping it.
;;   :new        what to replace it with — the guard, removed or inverted
;;   :killed-by  the deftest name that must appear among the failures
;;   :why        what the mutant restores, in one line
;;
;; Deliberately not generated. A generator finds mutants nobody thought of and
;; produces noise nobody triages; this list is short, every line of it earned
;; its place, and an anchor that stops matching is information.

[;; ---------------------------------------------- the contract hook's parser
 {:file "scripts/hooks/run-contract.sh"
  :ns "contract"
  :old "printf '%s' \"$scan\" | tr"
  :new "printf '%s' \"$bare\" | tr"
  :killed-by "a-command-is-parsed-as-commands-not-as-words"
  :why "splits the command inside quoted spans, so prose in a note.bb claim reads as a command"}

 {:file "scripts/hooks/run-contract.sh"
  :ns "contract"
  :old "          for|case|in|done|fi|esac|\"}\"|\"]]\"|\"]\") continue ;;"
  :new "          zzznever) continue ;;"
  :killed-by "a-command-is-parsed-as-commands-not-as-words"
  :why "judges `for` as a command name, so a for-loop read is refused"}

 {:file "scripts/hooks/run-contract.sh"
  :ns "contract"
  :old "        if [ \"$head_word\" = \"git\" ]; then"
  :new "        if [ \"$head_word\" = \"zzznever\" ]; then"
  :killed-by "a-command-is-parsed-as-commands-not-as-words"
  :why "refuses every git subcommand, including `git log` and `git status`"}

 {:file "scripts/hooks/run-contract.sh"
  :ns "contract"
  :old "count-objects|branch|remote|grep) continue ;;"
  :new "count-objects|branch|remote|grep|checkout|restore) continue ;;"
  :killed-by "a-command-is-parsed-as-commands-not-as-words"
  :why "treats `git checkout -- goal.md` as a read, which restores the truth from the index"}

 {:file "scripts/hooks/run-contract.sh"
  :ns "contract"
  :old "            do|then|else|elif|if|while|until|\"{\"|\"!\") continue ;;"
  :new "            zzznever) continue ;;"
  :killed-by "a-command-is-parsed-as-commands-not-as-words"
  :why "judges `do` and `if` as command names instead of advancing to the real one"}

